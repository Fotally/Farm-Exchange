root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.cs]
indent_style = space
indent_size = 4

# 类型、方法、属性和常量遵循现有 PascalCase；私有实例字段的语义约束见 scripts/AGENTS.md。
dotnet_naming_symbols.types.applicable_kinds = class, struct, interface, enum, delegate
dotnet_naming_rule.types_pascal.symbols = types
dotnet_naming_rule.types_pascal.style = pascal_case
dotnet_naming_rule.types_pascal.severity = suggestion
dotnet_naming_style.pascal_case.capitalization = pascal_case

[*.{md,yml,yaml,tscn,cfg}]
indent_style = space
