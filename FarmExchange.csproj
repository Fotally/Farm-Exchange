<Project Sdk="Godot.NET.Sdk/4.7.2">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>FarmExchange</RootNamespace>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="build/**/*.cs" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.1" />
    <PackageReference Include="Serilog" Version="4.3.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(Configuration)' != 'Debug' And '$(Configuration)' != 'ExportDebug'">
    <Compile Remove="scripts/**/development/**/*.cs" />
    <Compile Remove="tests/**/*.cs" />
  </ItemGroup>
  <Target Name="PrepareDevelopmentScenarioConfigurations" BeforeTargets="BeforeBuild"
          Condition="'$(Configuration)' == 'Debug' Or '$(Configuration)' == 'ExportDebug'">
    <ItemGroup>
      <DevelopmentScenarioConfiguration Include="$(MSBuildProjectDirectory)/tests/scenario-configs/buy-process-sell/wheat-basic-r1.json" TargetFileName="wheat_basic_r1.json" />
      <DevelopmentScenarioConfiguration Include="$(MSBuildProjectDirectory)/tests/scenario-configs/buy-process-sell/radish-three-r1.json" TargetFileName="radish_three_r1.json" />
      <DevelopmentScenarioConfiguration Include="$(MSBuildProjectDirectory)/tests/scenario-configs/buy-process-sell/current-radish-r1.json" TargetFileName="current_radish_r1.json" />
    </ItemGroup>
    <Copy SourceFiles="@(DevelopmentScenarioConfiguration)"
          DestinationFiles="@(DevelopmentScenarioConfiguration->'$(MSBuildProjectDirectory)/assets/development/scenario_configs/%(TargetFileName)')"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
